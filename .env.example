# ==============================================================================
# CiteCheck AI — Environment Configuration
# "CiteCheck blocks unsupported AI claims before publication —
#  every finding is cited, verified, and human-approved."
# ==============================================================================

# --- Database & Persistence (Optional: falls back to in-memory store if unset) ---
# Supabase Project Credentials (Dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_public_key_here

# Supabase / Application JWT Secret (Dashboard → Settings → API → JWT Secret)
# Used for HS256 local token validation and role-based access control
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
JWT_SECRET=your_fallback_jwt_secret_here

# Default Brand Kit UUID (seeded in schema.sql & seed_demo.py)
DEFAULT_BRAND_KIT_ID=a1b2c3d4-e5f6-7890-abcd-111111111111

# --- Optional Honest LLM Reviewer (Falls back to deterministic rules if unset) ---
# Supported providers: gemini | anthropic | openai
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_anthropic_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_S=8

# --- Security & Rate Limiting ---
RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000", "https://citecheck-jet.vercel.app"]

# --- Frontend Environment (Vite) ---
VITE_API_BASE_URL=/api
VITE_USE_FIXTURES=false

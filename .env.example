# Supabase Project Credentials
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_public_key_here

# Supabase JWT Secret (From Dashboard → Settings → API → JWT Settings → JWT Secret)
# Used for instant, zero-latency local token verification via HS256
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Default Brand Kit ID (seeded in schema.sql)
DEFAULT_BRAND_KIT_ID=a1b2c3d4-e5f6-7890-abcd-111111111111

# Allowed CORS Origins (JSON list or comma-separated string)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]

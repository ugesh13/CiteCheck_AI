# ==============================================================================
# CiteCheck AI Backend — Environment Configuration
# ==============================================================================

# --- Supabase Database (Optional: falls back to in-memory store if unset) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_public_key_here

# JWT Signing Secret for HS256 Authentication & Server-Side Role Enforcement
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
JWT_SECRET=your_fallback_jwt_secret_here

# Default Brand Kit UUID (matches seed data)
DEFAULT_BRAND_KIT_ID=a1b2c3d4-e5f6-7890-abcd-111111111111

# --- Optional Honest LLM Reviewer Configuration ---
# If unset, CiteCheck operates honestly in deterministic rules-only mode.
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_S=8

# --- Security & Traffic Management ---
RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000", "https://citecheck-jet.vercel.app"]
